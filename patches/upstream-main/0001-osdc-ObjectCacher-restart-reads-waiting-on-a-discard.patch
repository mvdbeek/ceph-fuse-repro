From cfa9589b03d7b5231d04f401e3acd3cb2c2c6cea Mon Sep 17 00:00:00 2001
From: mvdbeek <m.vandenbeek@gmail.com>
Date: Sun, 8 Nov 2026 15:49:37 +0100
Subject: [PATCH 1/2] osdc/ObjectCacher: restart reads waiting on a discarded
 rx bh

Object::discard() turns a bh with a read in flight (rx) into a zero bh but
leaves the read's waiters on it. A zero bh is not pinned in the LRU, so
trim() or release() can delete it, waiters included, before the OSD reply
arrives; bh_read_finish() then finds no bh and the read never completes.
In ceph-fuse the FUSE read request is never answered, the page stays
locked, a later invalidate from the MDS blocks in
fuse_reverse_inval_inode(), and the leaked Fc cap ref blocks other clients.

Restart the waiters right away instead, as discard already does for bhs
in other states; the retried read sees the zeroed range.

Signed-off-by: mvdbeek <m.vandenbeek@gmail.com>
---
 src/osdc/ObjectCacher.cc | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/osdc/ObjectCacher.cc b/src/osdc/ObjectCacher.cc
index 003e38e..d0a3e04 100644
--- a/src/osdc/ObjectCacher.cc
+++ b/src/osdc/ObjectCacher.cc
@@ -657,6 +657,13 @@ void ObjectCacher::Object::discard(loff_t off, loff_t len,
       bh->bl.clear();
       bh->set_nocache(true);
       oc->mark_zero(bh);
+      // a zero bh is not pinned, so trim() or release() may delete it
+      // before the read reply arrives, and bh_read_finish() could then not
+      // find the waiters. restart them now; they will see the zeroed range.
+      for ([[maybe_unused]] auto& [off, ctxs] : bh->waitfor_read) {
+        waiting_for_read.splice(waiting_for_read.end(), ctxs);
+      }
+      bh->waitfor_read.clear();
       // we should mark all Rx bh to zero
       continue;
     } else {
